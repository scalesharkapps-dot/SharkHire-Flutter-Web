# SharkHire build settings – reference only.
#
# Flutter does not read .env files. These values are passed at build time
# with --dart-define (or --dart-define-from-file=config/<env>.json), and on
# Vercel by tool/vercel_build.sh.
#
# Everything here ends up inside the web app that browsers download, so it is
# PUBLIC by nature. Never put API keys, passwords, tokens or backend secrets
# in these settings. The backend keeps its own secrets (Supabase service key,
# JSearch/RapidAPI key) on the server.

# development | staging | production
APP_ENV=production

# true = built-in sample data (development only); must be false in production
USE_MOCK_DATA=false

# Backend base URL.
# Web on Vercel: "same-origin" (the site forwards /api/* to the backend).
# Android/iOS: the backend's public https address.
API_BASE_URL=same-origin
