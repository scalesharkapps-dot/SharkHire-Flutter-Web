# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets – never commit (guide §2.3 / §3.16)
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties

# Real build settings (server addresses, Supabase anon key). Only the *.example.json files are committed.
config/*.json
!config/*.example.json

# Vercel project link (created by `vercel link`)
.vercel

# Flutter SDK downloaded by tool/vercel_build.sh
.flutter-sdk/

.vercel
.env*
!.env.example
